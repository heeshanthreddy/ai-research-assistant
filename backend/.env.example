# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32+chars
# PostgreSQL example (as in the original project):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/researchforge
# Leave DATABASE_URL unset to use a local SQLite file instead.

# auto | minilm | hashing   (see README)
EMBEDDING_BACKEND=auto
